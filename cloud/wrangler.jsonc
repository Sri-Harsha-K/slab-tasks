// Slab Tasks cloud connector. Setup and deploy steps: cloud/README.md
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "slab-tasks",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    // The URL MCP clients connect to. Set it to your deployed URL: https://slab-tasks.<subdomain>.workers.dev/mcp
    "MCP_RESOURCE": "http://localhost:8788/mcp",
    // The only GitHub account allowed to sign in.
    "ALLOWED_GITHUB_LOGIN": "Sri-Harsha-K",
    // Your name as it appears in meetings, your time zone, and the backfill cutoff (optional ISO time).
    "OWNER": "Harsha (Venkata Subrahmanya Sri Harsha Kalaga)",
    "TIME_ZONE": "America/Los_Angeles",
    "SINCE": "2026-10-29T21:00:00Z"
  },
  "durable_objects": {
    "bindings": [{ "name": "TASK_STORE", "class_name": "TaskStore" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["TaskStore"] }],
  // Created with: npx wrangler kv namespace create OAUTH_KV   (paste the id here)
  "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "<Add-KV-ID>" }],
  "observability": { "enabled": true },
  "dev": { "port": 8788 },
  // Set with: npx wrangler secret put <NAME>   (locally: in .dev.vars)
  "secrets": { "required": ["GITHUB_CLIENT_ID", "GITHUB_CLIENT_SECRET", "COOKIE_ENCRYPTION_KEY"] }
}
