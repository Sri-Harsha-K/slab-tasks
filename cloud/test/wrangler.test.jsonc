// Test-only config for the unauthenticated test entry. Not for deploying.
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "slab-tasks-test",
  "main": "entry.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "vars": {
    "MCP_RESOURCE": "http://localhost:8799/mcp",
    "ALLOWED_GITHUB_LOGIN": "Sri-Harsha-K",
    "OWNER": "Harsha (Venkata Subrahmanya Sri Harsha Kalaga)",
    "TIME_ZONE": "America/Los_Angeles",
    "SINCE": "2026-10-29T21:00:00Z"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "TASK_STORE",
        "class_name": "TaskStore"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "TaskStore"
      ]
    }
  ],
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      "id": "test"
    }
  ],
  "observability": {
    "enabled": true
  },
  "dev": {
    "port": 8799
  }
}
