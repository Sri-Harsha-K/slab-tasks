{
  "name": "slab-tasks",
  "productName": "Slab Tasks",
  "version": "1.0.0",
  "description": "A neobrutalist desktop to-do list that Claude can write to",
  "author": "Slab",
  "main": "electron/main.cjs",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:mcp": "esbuild mcp/server.mjs --bundle --platform=node --target=node20 --format=esm --outfile=mcp-dist/server.mjs --banner:js=\"import { createRequire as __cr } from 'node:module'; const require = __cr(import.meta.url);\"",
    "start": "vite build && electron .",
    "dist:win": "vite build && npm run build:mcp && electron-builder --win",
    "brand": "node scripts/brand.mjs",
    "test": "node --test test/*.test.js",
    "test:mcp": "npm run build:mcp && node --test test/mcp.test.mjs",
    "test:e2e": "vite build && node test/e2e.mjs"
  },
  "build": {
    "appId": "com.slab.tasks",
    "productName": "Slab Tasks",
    "files": [
      "dist/**",
      "electron/**",
      "shared/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "mcp-dist",
        "to": "mcp"
      }
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "afterPack": "build/afterPack.cjs",
    "nsis": {
      "artifactName": "Slab-Tasks-Setup-${version}.exe",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Slab Tasks",
      "uninstallDisplayName": "Slab Tasks",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/uninstallerSidebar.bmp",
      "installerHeader": "build/installerHeader.bmp"
    },
    "publish": null,
    "compression": "maximum",
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableCookieEncryption": true,
      "onlyLoadAppFromAsar": true,
      "enableEmbeddedAsarIntegrityValidation": false,
      "loadBrowserProcessSpecificV8Snapshot": false,
      "grantFileProtocolExtraPrivileges": true
    }
  },
  "devDependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.9.3",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "pe-library": "^2.0.1",
    "playwright": "^1.56.1",
    "pngjs": "^7.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "resedit": "^3.1.0",
    "vite": "^7.3.7",
    "zod": "^4.6.7"
  },
  "type": "module"
}
